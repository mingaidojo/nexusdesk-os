# NexusDesk Configuration Example
# Copy to .env and customize before starting.

# Server bind address & port (set host to 0.0.0.0 inside Docker)
NEXUSDESK_HOST=127.0.0.1
NEXUSDESK_PORT=9200

# Security (set NEXUSDESK_AUTH_ENABLED=true when exposing beyond localhost)
NEXUSDESK_AUTH_ENABLED=false
NEXUSDESK_SECRET_KEY=replace-with-a-long-random-hex-secret

# Edition & War Room limits (0 = unlimited)
NEXUSDESK_EDITION=oss
NEXUSDESK_MAX_CUSTOM_WAR_ROOMS=3
NEXUSDESK_MAX_WAR_ROOM_AGENTS=3
